---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Streich Force Enterprises &mdash; streichforce.com</p>
      <div class="hero-wm">
        <img src="/Brand/SF_Logo_Transparent_DarkBG.svg" alt="Streich Force Enterprises" class="hero-logo" width="569" height="160" />
      </div>
      <div class="hero-tagline">
        <h1 class="hero-tag-main">Real work. Real systems. No middlemen.</h1>
        <p class="hero-tag-sub">One company that does the work on site and builds the systems behind it. 40+ years in the field, and every job we do runs on SF Ops, the operations software we built ourselves.</p>
        <a href="#doors" class="hero-tag-cta">Two ways in &darr;</a>
      </div>
    </div>
    <div class="hero-scroll"><span>Scroll</span></div>
  </section>

  <!-- TWO FRONT DOORS -->
  <section class="doors" id="doors">
    <div class="div-section-head">
      <p class="div-section-eye">Two Ways In</p>
      <h2 class="div-section-title">What Do You Need?</h2>
    </div>
    <div class="door-grid">

      <article class="door ent">
        <p class="door-tag">Streich Force Services</p>
        <h3 class="door-title"><a href="/services">Need it fixed or built on site?</a></h3>
        <p class="door-desc">Commercial repair, custom fabrication and site maintenance for pharmacy and retail chains and other multi-site operators. Diagnosed right, done right the first time.</p>
        <ul class="door-checks">
          <li>40+ years in the field</li>
          <li>Trusted by national pharmacy and retail chains</li>
          <li>Every job runs on SF Ops: approve the Quote from your phone, see the photos, get the Work summary and pay online</li>
        </ul>
        <div class="door-actions">
          <a href="/contact/enterprise" class="door-cta">Request service</a>
          <a href="/services" class="door-mi">See Services &rarr;</a>
        </div>
      </article>

      <article class="door sol">
        <p class="door-tag">Streich Force Solutions</p>
        <h3 class="door-title"><a href="/solutions">Systems don't talk to each other?</a></h3>
        <p class="door-desc">Keep the systems that work. We connect them. For small and mid-sized operators running on QuickBooks or Xero, a CRM, spreadsheets, email and text: we set up the automation and applications you need, around the tools you already use.</p>
        <ul class="door-checks">
          <li>Your tools connected, the exceptions surfaced</li>
          <li>SF Ops as your workspace, if you want it</li>
          <li>Proven with container dealers, lessors and depots</li>
        </ul>
        <div class="door-actions">
          <a href="/contact/solutions" class="door-cta">Book a discovery call</a>
          <a href="/solutions" class="door-mi">See Solutions &rarr;</a>
        </div>
      </article>

    </div>
    <p class="door-aside">Buying a container? We source those too. <a href="/containers">Tell us what you need &rarr;</a></p>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <div>
      <p class="div-section-eye">About Streich Force</p>
      <h2 class="div-section-title" style="margin-bottom:2rem;">We Do the Work.<br />We Built the System It Runs On.</h2>
      <div class="about-text">
        <p>Streich Force started in the field. We have spent more than 40 years diagnosing, repairing and building for commercial sites, national pharmacy and retail chains among them, and we still do that work ourselves.</p>
        <p>Running that work across Sites and Field techs took more than spreadsheets and email. So we built our own operations software, <strong>SF Ops</strong>, and every Streich Force job runs on it: the Work order, the Quote approved from your phone, the on-site photos, the Work summary, the invoice and the payment.</p>
        <p>That is what we bring to other operators. <strong>Services</strong> does the work on your sites. <strong>Solutions</strong> sets up the systems behind your own operation, around the tools you already use, with SF Ops as your workspace if you want it.</p>
      </div>
    </div>
    <div class="about-stats">
      <div class="stat">
        <div class="stat-val">40+<br />Years</div>
        <div class="stat-lbl">Hands-on work in the field, for the kinds of sites we still serve today.</div>
      </div>
      <div class="stat">
        <div class="stat-val">Every Job<br />on SF Ops</div>
        <div class="stat-lbl">The software we sell is the software we run our own business on.</div>
      </div>
      <div class="stat">
        <div class="stat-val">No<br />Middlemen</div>
        <div class="stat-lbl">You work directly with the people doing the job, on site and in your systems.</div>
      </div>
      <div class="stat">
        <div class="stat-val">Built for<br />Results</div>
        <div class="stat-lbl">We measure success by what gets fixed, built and working. Nothing else.</div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-band" id="contact">
    <div>
      <h3 class="cta-title">Pick Your Door</h3>
      <p class="cta-sub">Something broken or to build on site? Request service. Systems that don't talk to each other? Book a discovery call. Each one goes straight to the right team.</p>
    </div>
    <div class="cta-actions">
      <a href="/contact/enterprise" class="sf-btn-primary">Request service</a>
      <a href="/contact/solutions" class="sf-btn-ghost">Book a discovery call</a>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
/* ── HERO ── */
.hero {
  height: 100vh; min-height: 620px;
  display: flex; align-items: flex-end;
  padding: 0 var(--sf-pad) 4.5rem;
  position: relative; overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0; z-index: 0;
  background-image: url('/hero-bg.png');
  background-size: cover; background-position: center right;
  opacity: 0.28; filter: grayscale(20%) sepia(10%);
}
.hero-overlay {
  position: absolute; inset: 0; z-index: 1;
  background:
    linear-gradient(to top, rgba(17,17,17,1) 0%, rgba(17,17,17,0.75) 30%, rgba(17,17,17,0.2) 60%, rgba(17,17,17,0.4) 100%),
    linear-gradient(to right, rgba(17,17,17,0.5) 0%, transparent 55%);
}
.hero-grid {
  position: absolute; inset: 0; z-index: 2;
  background-image:
    linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px);
  background-size: 56px 56px;
  animation: gridDrift 24s linear infinite;
}
@keyframes gridDrift { from{transform:translateY(0)} to{transform:translateY(56px)} }
.hero-glow {
  position: absolute; top: -20%; right: -10%; z-index: 2;
  width: 50%; height: 80%;
  background: radial-gradient(ellipse at top right, rgba(192,57,43,0.06), transparent 65%);
  pointer-events: none;
}
.hero-content { position: relative; z-index: 3; max-width: 800px; }
.hero-eyebrow {
  font-family: var(--sf-font-display); font-weight: 600; font-size: 0.78rem;
  letter-spacing: 0.38em; text-transform: uppercase; color: var(--sf-ent-b);
  margin-bottom: 1.25rem;
  opacity: 0; animation: sf-rise-up 0.7s ease forwards 0.2s;
}
.hero-wm {
  opacity: 0; animation: sf-rise-up 0.7s ease forwards 0.4s;
  margin-bottom: 1.75rem;
}
.hero-logo {
  height: clamp(90px, 14vw, 160px);
  width: auto; display: block;
}
.hero-tagline { opacity: 0; animation: sf-rise-up 0.7s ease forwards 0.7s; }
.hero-tag-main {
  font-family: var(--sf-font-display); font-weight: 700;
  font-size: clamp(1.6rem, 3.2vw, 2.4rem);
  text-transform: uppercase;
  color: var(--sf-text-primary); letter-spacing: 0.03em;
  margin-bottom: 0.9rem; line-height: 1.15;
}
.hero-tag-sub {
  font-size: 1.05rem; font-weight: 400; line-height: 1.7; max-width: 640px;
  color: var(--sf-text-secondary); margin-bottom: 1.25rem;
}
.hero-tag-cta {
  font-family: var(--sf-font-display); font-weight: 600;
  font-size: 0.78rem;
  text-transform: uppercase; color: var(--sf-ent-b);
  letter-spacing: 0.18em;
}
.hero-tag-cta:hover { color: var(--sf-text-primary); }
.hero-scroll {
  position: absolute; bottom: 2rem; right: var(--sf-pad); z-index: 3;
  display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  opacity: 0; animation: sf-fade-in 1s ease forwards 1.5s;
}
.hero-scroll span {
  font-family: var(--sf-font-display); font-weight: 600; font-size: 0.62rem;
  letter-spacing: 0.3em; text-transform: uppercase; color: var(--sf-text-muted); writing-mode: vertical-rl;
}
.hero-scroll::after {
  content: ''; width: 1px; height: 44px;
  background: linear-gradient(to bottom, var(--sf-rust), transparent);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* ── SECTION HEADS ── */
.div-section-head { margin-bottom: 3rem; }
.div-section-eye {
  font-family: var(--sf-font-display); font-weight: 600; font-size: 0.78rem;
  letter-spacing: 0.4em; text-transform: uppercase; color: var(--sf-ent-b); margin-bottom: 0.6rem;
}
.div-section-title {
  font-family: var(--sf-font-display); font-weight: 900;
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  text-transform: uppercase; letter-spacing: 0.02em; color: var(--sf-text-primary); line-height: 1;
}

/* ── TWO FRONT DOORS ── */
.doors { padding: 5rem var(--sf-pad); border-top: 1px solid var(--sf-border); }
.door-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }
.door {
  position: relative; background: var(--sf-surface);
  border-top: 5px solid; padding: 2.75rem 2.5rem;
  display: flex; flex-direction: column;
  transition: background 0.25s;
}
.door:hover { background: var(--sf-card-hover); }
.door.ent { border-top-color: var(--sf-ent); }
.door.sol { border-top-color: var(--sf-sol); }
.door-tag {
  font-family: var(--sf-font-display); font-weight: 600; font-size: 0.72rem;
  letter-spacing: 0.35em; text-transform: uppercase; margin-bottom: 0.6rem;
}
.door.ent .door-tag { color: var(--sf-ent-b); }
.door.sol .door-tag { color: var(--sf-sol-b); }
.door-title {
  font-family: var(--sf-font-display); font-weight: 900;
  font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  text-transform: uppercase; letter-spacing: 0.02em;
  color: var(--sf-text-primary); line-height: 1.05; margin-bottom: 1rem;
}
/* The title link covers the whole card; the buttons sit above it. */
.door-title a::after { content: ''; position: absolute; inset: 0; }
.door.ent:hover .door-title a { color: var(--sf-ent-b); }
.door.sol:hover .door-title a { color: var(--sf-sol-b); }
.door-desc {
  font-size: 1rem; color: var(--sf-text-secondary); line-height: 1.7; margin-bottom: 1.25rem;
}
.door-checks {
  list-style: none; padding: 0; margin: 0 0 2rem 0;
  display: flex; flex-direction: column; gap: 0.45rem;
}
.door-checks li {
  font-size: 0.95rem; color: var(--sf-text-secondary); line-height: 1.5;
  padding-left: 1.5rem; position: relative;
}
.door-checks li::before { content: '\2714'; position: absolute; left: 0; }
.door.ent .door-checks li::before { color: var(--sf-ent-b); }
.door.sol .door-checks li::before { color: var(--sf-sol-b); }
.door-actions {
  margin-top: auto; position: relative; z-index: 1;
  display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;
}
.door-cta {
  display: inline-block; font-family: var(--sf-font-display); font-weight: 700;
  font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 0.8rem 1.6rem; color: #fff; transition: background 0.2s;
}
.door.ent .door-cta { background: var(--sf-ent); }
.door.sol .door-cta { background: var(--sf-sol); }
.door-cta:hover { text-decoration: underline; text-underline-offset: 3px; }
.door-mi {
  display: inline-block; font-family: var(--sf-font-display); font-weight: 600;
  font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 0.8rem 1.2rem; color: var(--sf-text-secondary); transition: color 0.2s;
}
.door-mi:hover { color: var(--sf-text-primary); }
.door-aside {
  margin-top: 1.5rem; font-size: 0.95rem; color: var(--sf-text-muted);
}
.door-aside a { color: var(--sf-con-b); text-decoration: underline; text-underline-offset: 3px; }
.door-aside a:hover { color: var(--sf-text-primary); }
/* ── ABOUT ── */
.about {
  padding: 6rem var(--sf-pad); border-top: 1px solid var(--sf-border);
  display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start;
}
.about-text p { font-size: 1.05rem; font-weight: 400; color: var(--sf-text-secondary); line-height: 1.8; margin-bottom: 1.25rem; }
.about-text strong { color: var(--sf-text-primary); font-weight: 500; }
.about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--sf-border); align-content: start; }
.stat { background: var(--sf-surface); padding: 2rem 1.75rem; }
.stat-val {
  font-family: var(--sf-font-display); font-weight: 900; font-size: 1.6rem;
  color: var(--sf-rust); line-height: 1.1; margin-bottom: 0.75rem;
  text-transform: uppercase; letter-spacing: 0.02em;
}
.stat-lbl { font-size: 0.95rem; font-weight: 400; color: var(--sf-text-secondary); line-height: 1.7; }

/* ── CTA ── */
.cta-band {
  margin: 0 var(--sf-pad) 6rem; padding: 3.5rem 4rem;
  background: var(--sf-surface); border-left: 5px solid var(--sf-rust);
  display: flex; align-items: center; justify-content: space-between;
  gap: 2.5rem; flex-wrap: wrap; position: relative; overflow: hidden;
}
.cta-band::after {
  content: 'SF'; position: absolute; right: 2rem; top: 50%; transform: translateY(-50%);
  font-family: var(--sf-font-display); font-weight: 900; font-size: 9rem;
  color: rgba(255,255,255,0.025); pointer-events: none; user-select: none;
}
.cta-title { font-family: var(--sf-font-display); font-weight: 900; font-size: clamp(1.4rem, 2.5vw, 2rem); text-transform: uppercase; color: var(--sf-text-primary); margin-bottom: 0.4rem; }
.cta-sub { font-size: 1rem; font-weight: 400; color: var(--sf-text-secondary); line-height: 1.6; max-width: 560px; }
.cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; position: relative; z-index: 1; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .door-grid { grid-template-columns: 1fr; }
  .door { padding: 2.25rem 1.5rem; }
  .about { grid-template-columns: 1fr; gap: 3rem; }
  .about-stats { grid-template-columns: 1fr 1fr; }
  .cta-band { flex-direction: column; align-items: flex-start; padding: 2.5rem 2rem; }
}
@media (max-width: 480px) {
  .cta-actions a { white-space: normal; text-align: center; width: 100%; }
}
</style>
