---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  title="Division 02 — SF Solutions — Streich Force"
  description="For small and mid-sized operators whose systems don't talk to each other. Keep the tools you have; we connect them, flag what needs attention, and set up the automation and applications you need.">
  <Nav active="solutions" />

  <section class="div-hero">
    <div class="div-hero-bg"></div>
    <div class="div-hero-inner">
      <p class="sf-eyebrow sol-eye">Division 02 — SF Solutions</p>
      <h1 class="div-hero-title">Keep the Tools You Have.<br /><span class="sol-accent">We Connect Them.</span></h1>
      <p class="div-hero-sub">QuickBooks or Xero. A CRM. Spreadsheets. Email and text. Most operators run on all of them, and none of them talk to each other.</p>
      <p class="div-hero-sub">We connect your systems, flag what needs attention, and set up the automation and applications you need. If you want one place to run the work, SF Ops can be your workspace.</p>
      <div class="div-hero-cta">
        <a href="/contact/solutions" class="btn-primary sol-btn">Book a Discovery Call</a>
        <a href="#how-it-starts" class="btn-ghost sol-ghost">How It Starts</a>
      </div>
    </div>
    <div class="hero-accent-bar sol-bar"></div>
  </section>

  <section class="content-section">
    <div class="section-inner">
      <h2 class="section-title sol-title">Sound Familiar?</h2>
      <div class="boxes-4">
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>The same numbers typed into two or three systems</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>The real answer lives in someone's spreadsheet</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>Orders and requests arrive by email and text</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>Problems show up after they've already cost money</p></div>
      </div>
    </div>
  </section>

  <section class="content-section alt">
    <div class="section-inner">
      <h2 class="section-title sol-title">What We Do</h2>
      <div class="boxes-4">
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Connect your tools.</strong> Your accounting, your CRM and your records, pulled into one view. We've built connectors for QuickBooks and Pipedrive.</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Flag the exceptions.</strong> See what needs attention now, instead of digging through reports to find it.</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Automate the manual steps.</strong> Less retyping, fewer copy-paste errors, less time on admin.</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Build what's missing.</strong> Dashboards and applications set up around how you already work.</p></div>
      </div>
    </div>
  </section>

  <section class="content-section" id="how-it-starts">
    <div class="section-inner">
      <h2 class="section-title sol-title">How It Starts</h2>
      <div class="boxes-4 centered">
        <div class="box step-box"><div class="step-ghost" style="color:var(--sf-sol)">1</div><p><strong>Discover</strong><br />We map your tools, your numbers and where they break.</p></div>
        <div class="box step-box"><div class="step-ghost" style="color:var(--sf-sol)">2</div><p><strong>Implement</strong><br />We connect your systems and set up what you need.</p></div>
        <div class="box step-box"><div class="step-ghost" style="color:var(--sf-sol)">3</div><p><strong>Stabilize</strong><br />We check the numbers with you and fix what's off until you trust them.</p></div>
        <div class="box step-box"><div class="step-ghost" style="color:var(--sf-sol)">4</div><p><strong>Operate</strong><br />You run it, or we run it for you.</p></div>
      </div>
    </div>
  </section>

  <section class="content-section alt">
    <div class="section-inner">
      <h2 class="section-title sol-title">SF Ops: Your Workspace (Optional)</h2>
      <p class="section-lead">We built SF Ops and run every Streich Force job on it. If you need one place to run the work, we set it up around how you operate.</p>
      <div class="boxes-4">
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>Every job as a Work order, from request to paid invoice</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>Quotes your customer approves from their phone</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>On-site photos and a Work summary on every job</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p>Invoices your customer can pay online</p></div>
      </div>
      <p class="section-note">SF Ops starts with a discovery call, like everything else we do.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="section-inner">
      <h2 class="section-title sol-title">Proven With Container Operators</h2>
      <p class="section-lead">Container dealers, lessors and depots were first. Here is what we built for them, on top of the systems they already had.</p>
      <div class="boxes-3">
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Cash-exposure cockpit.</strong> How much cash is tied up in inventory, and what's still coming due, in one view.</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Dashboards.</strong> Margin by size and type, aging, and the metrics you choose, switched on or off per person.</p></div>
        <div class="box"><span class="box-bullet sol-bullet">▸</span><p><strong>Query builder.</strong> Pick columns, stack filters, save views and export, over your own data.</p></div>
      </div>
      <p class="section-note">Not in containers? The approach is the same: we set up the automation and applications you need, around the tools you already use.</p>
    </div>
  </section>

  <section class="div-cta">
    <div class="cta-inner">
      <div class="cta-rule sol-bar"></div>
      <h2 class="cta-title">Book a Discovery Call</h2>
      <p class="cta-sub">Tell us what you run on and where it breaks. We'll give you a straight answer on whether we can help.</p>
      <a href="/contact/solutions" class="btn-primary sol-btn">Book a Discovery Call</a>
      <p class="cta-email"><a href="mailto:solutions&#x40;streichforce.com" class="sol-link">solutions&#x40;streichforce.com</a></p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
.div-hero{position:relative;padding:9rem var(--sf-pad) 7rem;background:var(--sf-black);overflow:hidden}
.div-hero-bg{position:absolute;inset:0;background:url('/hero-bg.png') center/cover no-repeat;opacity:.08;pointer-events:none}
.hero-accent-bar{position:absolute;bottom:0;left:0;right:0;height:4px}
.sol-bar{background:var(--sf-sol)}
.div-hero-inner{position:relative;z-index:1;max-width:900px}
.sol-eye{color:var(--sf-sol-b)}
.div-hero-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(2.8rem,7vw,6rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1;margin:1rem 0 1.5rem}
.sol-accent{color:var(--sf-sol)}
.div-hero-sub{font-size:1.05rem;color:var(--sf-text-secondary);max-width:640px;line-height:1.8;margin-bottom:1rem}
.div-hero-cta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}
.btn-primary{display:inline-block;font-family:var(--sf-font-display);font-weight:700;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;padding:.9rem 2rem;text-decoration:none;transition:background .2s}
.sol-btn{background:var(--sf-sol);color:#fff}
.sol-btn:hover{background:var(--sf-sol-b)}
.btn-ghost{display:inline-block;font-family:var(--sf-font-display);font-weight:700;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;padding:.9rem 2rem;text-decoration:none;border:1px solid rgba(255,255,255,.2);color:var(--sf-text-secondary);transition:all .2s}
.sol-ghost:hover{border-color:var(--sf-sol);color:var(--sf-sol)}
.content-section{padding:5rem var(--sf-pad);background:var(--sf-black)}
.content-section.alt{background:var(--sf-surface)}
.section-inner{max-width:1200px;margin:0 auto}
.section-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.6rem,3vw,2.4rem);text-transform:uppercase;letter-spacing:.04em;margin-bottom:2.5rem}
.sol-title{color:var(--sf-sol-b)}
.boxes-4{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
@media(max-width:900px){.boxes-4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.boxes-4{grid-template-columns:1fr}}
.boxes-3{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
@media(max-width:900px){.boxes-3{grid-template-columns:1fr}}
.section-lead{font-size:1.1rem;color:var(--sf-text-secondary);line-height:1.75;max-width:760px;margin:-1.25rem 0 2.5rem}
.section-note{font-size:1rem;color:var(--sf-text-muted);line-height:1.7;max-width:760px;margin-top:2rem}
.box p strong{color:var(--sf-text-primary);font-weight:600}
.box{background:var(--sf-surface);padding:2rem 1.75rem;display:flex;flex-direction:row;align-items:flex-start;gap:.85rem}
.content-section.alt .box{background:var(--sf-black)}
.box-bullet{font-size:1.4rem;line-height:1;flex-shrink:0}
.sol-bullet{color:var(--sf-sol);font-size:.95rem;flex-shrink:0;margin-top:.28em;line-height:1}
.box p{font-size:1.1rem;color:var(--sf-text-secondary);line-height:1.65;margin:0}
.boxes-4.centered{justify-items:stretch}
.step-box{align-items:center;text-align:center}
.div-cta{padding:7rem var(--sf-pad);background:var(--sf-black);text-align:center}
.cta-inner{max-width:680px;margin:0 auto}
.cta-rule{width:48px;height:4px;margin:0 auto 2.5rem}
.cta-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.8rem,4vw,3rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1.1;margin-bottom:1.25rem}
.cta-sub{font-size:1rem;color:var(--sf-text-secondary);line-height:1.75;margin-bottom:2rem}
.cta-email{margin-top:1.5rem;font-size:.9rem;color:var(--sf-text-muted)}
.sol-link{color:var(--sf-sol-b);text-decoration:none}
.sol-link:hover{text-decoration:underline}

.step-box{position:relative;align-items:center;text-align:center;flex-direction:column;justify-content:center;min-height:170px;overflow:hidden;gap:0;padding:1.5rem}
.step-ghost{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:var(--sf-font-display);font-weight:900;font-size:8rem;line-height:1;pointer-events:none;user-select:none;z-index:0;opacity:.13;letter-spacing:-.02em}
.step-box p{position:relative;z-index:1;font-size:1.1rem;color:var(--sf-text-primary);line-height:1.65;margin:0;font-weight:500;padding:0 .5rem}
</style>
