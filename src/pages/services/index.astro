---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGallery, type ServiceLine } from '../../lib/gallery';
import { SF_OPS_NUMBERS } from '../../data/sf-ops-numbers';

const featured = (await getGallery('services', { featuredOnly: true })).slice(0, 4);

// A service line links to the gallery once it has a real photo there
// (placeholders don't count, so no line links to "coming soon").
const photographed = new Set(
  (await getGallery('services'))
    .filter((e) => !e.id.startsWith('placeholder-'))
    .map((e) => e.data.serviceLine),
);

// Alphabetical; "Other / Miscellaneous" stays last. Same order as
// src/lib/service-lines.ts and the contact form's "Type of Work Needed".
const serviceLines: { line: ServiceLine; name: string; desc: string }[] = [
  { line: 'fabrication', name: 'Custom Fabrication', desc: "Custom-built components for commercial environments. If it doesn't exist off the shelf, we build it to spec: cabinetry, countertops, enclosures, access panels and structural components." },
  { line: 'doors', name: 'Doors', desc: 'Installation, repair and replacement of commercial doors, frames and hardware: storefront, back-of-house and security doors for retail and pharmacy Sites.' },
  { line: 'fit-outs', name: 'Pharmacy & Retail Fit-Outs', desc: 'Interior work for pharmacy and retail chain Sites: custom cabinetry, millwork, fixture fabrication and installation.' },
  { line: 'maintenance', name: 'Site Maintenance', desc: "Ongoing maintenance for commercial properties, done by people who know your Site and how it's built." },
  { line: 'structural', name: 'Structural Repairs', desc: 'Structural repair work that crosses trade lines: the jobs that fall outside standard scope and need someone who can solve across disciplines.' },
  { line: 'gates', name: 'Wall Access & Security Gates', desc: 'Wall access gates, security enclosures and controlled-access fabrications built to commercial specifications for retail and pharmacy Sites.' },
  { line: 'other', name: 'Other / Miscellaneous', desc: "Don't see your problem listed? If it's broken, custom, or has stumped someone else, tell us about it. That's usually exactly the kind of work we take on." },
];

// How a job runs, in the customer's order. Names from sf-ops docs/ontology.md.
const steps = [
  { title: 'You send it, we open a Work order', body: 'Request service here, by email, or through the work-order system you already use. It becomes a Work order with its own number, tied to your Site and your own job number.' },
  { title: 'Approve the Quote from your phone', body: 'If the job needs a Quote, you get a link. Open it on your phone, see every line, and approve or decline. No PDFs going back and forth.' },
  { title: 'Scheduled to your Client Due', body: "Your Client Due is your date, and only you move it. We plan to a Target ahead of it and tell you when we'll be on site." },
  { title: 'Photos from the Site', body: 'The Field tech checks in on site and takes before and completion photos, so you can see the work without driving out.' },
  { title: 'A Work summary when it’s done', body: 'You get a Work summary: what was done, each visit, and the photos. It is the record you can forward to your team.' },
  { title: 'Invoice, paid online', body: 'The invoice comes with a link to pay online by card or bank. It matches the Work summary line for line.' },
];

const showNumbers = SF_OPS_NUMBERS.approvedBy !== null;
const asOf = new Date(`${SF_OPS_NUMBERS.asOf}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title="Commercial Service & Repair — Streich Force"
  description="Repair, fabrication and site maintenance for national pharmacy and retail chains and multi-site operators. 40+ years, and every job runs on SF Ops: Quote approved from your phone, on-site photos, Work summary, invoice paid online.">
  <Nav active="services" />

  <!-- HERO -->
  <section class="div-hero">
    <div class="div-hero-bg"></div>
    <div class="div-hero-inner">
      <p class="sf-eyebrow ent-eye">Division 01 — Commercial Service &amp; Repair</p>
      <h1 class="div-hero-title">Done Right.<br /><span class="ent-accent">Tracked to the Finish.</span></h1>
      <p class="div-hero-sub">Repair, fabrication and site maintenance for national pharmacy and retail chains and other multi-site operators. We're who you call when the regular rotation can't fix it.</p>
      <p class="div-hero-sub">Every job runs on SF Ops, the software we built for our own work. You approve the Quote from your phone, see the photos from the Site, and get a Work summary when it's done.</p>
      <div class="div-hero-cta">
        <a href="/contact/enterprise" class="btn-primary ent-btn">Request Service</a>
        <a href="#how-a-job-runs" class="btn-ghost">How a Job Runs</a>
      </div>
    </div>
    <div class="hero-accent-bar ent-bar"></div>
  </section>

  <!-- PROOF -->
  <section class="proof-strip" aria-label="Why clients call us">
    <div class="section-inner proof-grid">
      <div class="proof"><span class="proof-big">40+</span><span class="proof-label">years of hands-on commercial work</span></div>
      <div class="proof"><span class="proof-big">National</span><span class="proof-label">pharmacy and retail chains we serve</span></div>
      <div class="proof"><span class="proof-big">Every job</span><span class="proof-label">runs on SF Ops, our own software</span></div>
      <div class="proof"><span class="proof-big">One team</span><span class="proof-label">across trades, so the job doesn't fall between them</span></div>
    </div>
  </section>

  <!-- SERVICE LINES -->
  <section class="content-section" id="service-lines">
    <div class="section-inner">
      <h2 class="section-title ent-title">Service Lines</h2>
      <div class="services-grid">
        {serviceLines.map((s) => (
          <div class={`service-item${s.line === 'other' ? ' service-other' : ''}`}>
            <div class="service-rule"></div>
            <h3 class="service-name">{s.name}</h3>
            <p class="service-desc">{s.desc}</p>
            {photographed.has(s.line) && (
              <a href="/services/gallery" class="service-link ent-link">See the work →</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW A JOB RUNS -->
  <section class="content-section alt" id="how-a-job-runs">
    <div class="section-inner">
      <p class="sf-eyebrow ent-eye">What happens after you press Request Service</p>
      <h2 class="section-title ent-title">How a Job Runs</h2>
      <ol class="job-steps">
        {steps.map((st, i) => (
          <li class="job-step">
            <span class="job-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="job-title">{st.title}</h3>
            <p class="job-body">{st.body}</p>
          </li>
        ))}
      </ol>
      {showNumbers && (
        <div class="ops-numbers">
          {SF_OPS_NUMBERS.numbers.map((n) => (
            <div class="ops-number"><span class="proof-big">{n.value}</span><span class="proof-label">{n.label}</span></div>
          ))}
          <p class="ops-asof">SF Ops numbers as of {asOf}.</p>
        </div>
      )}
    </div>
  </section>

  <!-- OUR LANE -->
  <section class="content-section">
    <div class="section-inner">
      <p class="sf-eyebrow ent-eye">Our Lane</p>
      <h2 class="lane-title">We're not in the regular rotation.<br />We're who you call when the rotation fails.</h2>
      <div class="pos-cards">
        <div class="pos-card">
          <div class="pos-num">01</div>
          <h3 class="pos-title">Diagnosed First</h3>
          <p class="pos-body">We find the real issue, not just the symptom, and fix it once. If you're tired of paying for the same problem twice, we're your call.</p>
        </div>
        <div class="pos-card">
          <div class="pos-num">02</div>
          <h3 class="pos-title">Cross-Trade Capability</h3>
          <p class="pos-body">Most repairs that fall through the cracks cross trade lines. We work across disciplines; that's exactly where we live.</p>
        </div>
        <div class="pos-card">
          <div class="pos-num">03</div>
          <h3 class="pos-title">Nothing to Chase</h3>
          <p class="pos-body">Quote, schedule, photos, Work summary and invoice all come to you from one system. You don't call to ask where the job is.</p>
        </div>
      </div>
      <div class="pills">
        <span class="pill">National Pharmacy Chains</span>
        <span class="pill">Retail Property Groups</span>
        <span class="pill">Commercial Landlords</span>
        <span class="pill">Facilities Managers</span>
        <span class="pill">Multi-Site Operators</span>
      </div>
    </div>
  </section>

  <!-- SEE OUR WORK -->
  {featured.length > 0 && (
    <section class="content-section alt">
      <div class="section-inner">
        <h2 class="section-title ent-title">See Our Work</h2>
        <GalleryGrid items={featured} name="featured" />
        <p class="see-all"><a href="/services/gallery" class="ent-link">See the full gallery →</a></p>
      </div>
    </section>
  )}

  <!-- SF OPS FOR YOUR OWN TEAM -->
  <section class="ops-band">
    <div class="section-inner ops-inner">
      <div>
        <p class="sf-eyebrow sol-eye">SF Ops</p>
        <h2 class="ops-title">Run Your Own Team on SF Ops</h2>
        <p class="ops-sub">The Quote link, the photos and the Work summary come from SF Ops, the software we built and run every Streich Force job on. Facilities teams can run their own work on it too, set up for you by SF Solutions.</p>
        <a href="/contact/solutions" class="btn-primary sol-btn">Book a Discovery Call</a>
      </div>
      <ul class="ops-list">
        <li>Work orders by Site, with your own job numbers</li>
        <li>Quotes your approver opens and decides from a link</li>
        <li>Field tech check-in, with before and completion photos</li>
        <li>Received, Target and Client Due on every Work order</li>
        <li>Work summaries sent to the customer when the job closes</li>
        <li>Invoices with a link to pay online</li>
      </ul>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="div-cta">
    <div class="cta-inner">
      <div class="cta-rule ent-bar"></div>
      <h2 class="cta-title">Get It Fixed Right</h2>
      <p class="cta-sub">Tell us what you're dealing with and where. You'll hear back with a straight answer on whether we're the right fit, and a Quote if the job needs one.</p>
      <a href="/contact/enterprise" class="btn-primary ent-btn">Request Service</a>
      <p class="cta-email"><a href="mailto:services&#x40;streichforce.com" class="ent-link">services&#x40;streichforce.com</a></p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
.div-hero{position:relative;padding:9rem var(--sf-pad) 7rem;background:var(--sf-black);overflow:hidden}
.div-hero-bg{position:absolute;inset:0;background:url('/hero-bg.png') center/cover no-repeat;opacity:.1;pointer-events:none}
.hero-accent-bar{position:absolute;bottom:0;left:0;right:0;height:4px}
.ent-bar{background:var(--sf-ent)}
.div-hero-inner{position:relative;z-index:1;max-width:900px}
.ent-eye{color:var(--sf-ent-b)}
.div-hero-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(2.8rem,7vw,6rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1;margin:1rem 0 1.5rem}
.ent-accent{color:var(--sf-ent)}
.div-hero-sub{font-size:1.05rem;color:var(--sf-text-secondary);max-width:640px;line-height:1.8;margin-bottom:1rem}
.div-hero-cta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}
.btn-primary{display:inline-block;font-family:var(--sf-font-display);font-weight:700;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;padding:.9rem 2rem;text-decoration:none;transition:background .2s}
.ent-btn{background:var(--sf-ent);color:#fff}
.ent-btn:hover{background:var(--sf-ent-b)}
.btn-ghost{display:inline-block;font-family:var(--sf-font-display);font-weight:700;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;padding:.9rem 2rem;text-decoration:none;border:1px solid rgba(255,255,255,.2);color:var(--sf-text-secondary);transition:all .2s}
.btn-ghost:hover{border-color:var(--sf-ent);color:var(--sf-ent)}

/* SECTIONS */
.content-section{padding:5rem var(--sf-pad);background:var(--sf-black)}
.content-section.alt{background:var(--sf-surface)}
.section-inner{max-width:1200px;margin:0 auto}
.section-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.6rem,3vw,2.4rem);text-transform:uppercase;letter-spacing:.04em;margin-bottom:2.5rem}
.ent-title{color:var(--sf-ent-b)}

/* CTA */
.div-cta{padding:7rem var(--sf-pad);background:var(--sf-black);text-align:center}
.cta-inner{max-width:680px;margin:0 auto}
.cta-rule{width:48px;height:4px;margin:0 auto 2.5rem}
.cta-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.8rem,4vw,3rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1.1;margin-bottom:1.25rem}
.cta-sub{font-size:1rem;color:var(--sf-text-secondary);line-height:1.75;margin-bottom:2rem}
.cta-email{margin-top:1.5rem;font-size:.9rem;color:var(--sf-text-muted)}
.ent-link{color:var(--sf-ent-b);text-decoration:none}
.ent-link:hover{text-decoration:underline}
.see-all{margin-top:1.75rem;font-family:var(--sf-font-display);font-weight:700;font-size:.85rem;letter-spacing:.18em;text-transform:uppercase}

/* OUR LANE */
.lane-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.8rem,3.5vw,2.8rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1.1;margin:.75rem 0 3rem}
.pos-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2px}
.pos-card{background:var(--sf-surface);padding:2.5rem}
.pos-num{font-family:var(--sf-font-display);font-weight:900;font-size:3.5rem;line-height:1;margin-bottom:1rem;color:var(--sf-ent);opacity:.25}
.pos-title{font-family:var(--sf-font-display);font-weight:700;font-size:1.2rem;letter-spacing:.1em;text-transform:uppercase;color:var(--sf-text-primary);margin-bottom:.75rem}
.pos-body{font-size:1rem;color:var(--sf-text-secondary);line-height:1.8}

/* SERVICE LINES */
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2px}
@media(max-width:500px){.services-grid{grid-template-columns:1fr}}
.service-item{background:var(--sf-surface);padding:2rem 2rem 2.5rem}
.service-rule{height:3px;width:40px;margin-bottom:1.5rem;background:var(--sf-ent)}
.service-name{font-family:var(--sf-font-display);font-weight:700;font-size:1.05rem;letter-spacing:.1em;text-transform:uppercase;color:var(--sf-text-primary);margin-bottom:.75rem}
.service-desc{font-size:1rem;color:var(--sf-text-secondary);line-height:1.8}
.service-other{grid-column:1/-1}
.service-link{display:inline-block;margin-top:1rem;font-family:var(--sf-font-display);font-weight:700;font-size:.8rem;letter-spacing:.18em;text-transform:uppercase}

/* PROOF */
.proof-strip{padding:3rem var(--sf-pad);background:var(--sf-surface);border-bottom:1px solid var(--sf-border)}
.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}
@media(max-width:900px){.proof-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.proof-grid{grid-template-columns:1fr}}
.proof,.ops-number{display:flex;flex-direction:column;gap:.35rem}
.proof-big{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.6rem,3vw,2.2rem);text-transform:uppercase;color:var(--sf-ent-b);line-height:1}
.proof-label{font-size:.95rem;color:var(--sf-text-secondary);line-height:1.5}

/* HOW A JOB RUNS */
.job-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
@media(max-width:900px){.job-steps{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.job-steps{grid-template-columns:1fr}}
.job-step{background:var(--sf-black);padding:2rem 1.75rem 2.25rem}
.job-num{display:block;font-family:var(--sf-font-display);font-weight:900;font-size:2.6rem;line-height:1;color:var(--sf-ent);opacity:.35;margin-bottom:.75rem}
.job-title{font-family:var(--sf-font-display);font-weight:700;font-size:1.1rem;letter-spacing:.08em;text-transform:uppercase;color:var(--sf-text-primary);margin-bottom:.6rem}
.job-body{font-size:1rem;color:var(--sf-text-secondary);line-height:1.75;margin:0}
.ops-numbers{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}
@media(max-width:700px){.ops-numbers{grid-template-columns:1fr}}
.ops-asof{grid-column:1/-1;font-size:.85rem;color:var(--sf-text-muted);margin:0}

/* SF OPS BAND */
.ops-band{padding:5.5rem var(--sf-pad);background:var(--sf-surface);border-top:4px solid var(--sf-sol)}
.ops-inner{display:grid;grid-template-columns:1.1fr 1fr;gap:3.5rem;align-items:center}
@media(max-width:900px){.ops-inner{grid-template-columns:1fr;gap:2.5rem}}
.sol-eye{color:var(--sf-sol-b)}
.ops-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.8rem,3.5vw,2.8rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1.1;margin:.75rem 0 1.25rem}
.ops-sub{font-size:1.05rem;color:var(--sf-text-secondary);line-height:1.8;margin-bottom:2rem}
.sol-btn{background:var(--sf-sol);color:#fff}
.sol-btn:hover{background:var(--sf-sol-b)}
.ops-list{list-style:none;padding:0;margin:0;display:grid;gap:2px}
.ops-list li{background:var(--sf-black);padding:1rem 1.25rem 1rem 2.6rem;position:relative;font-size:1rem;color:var(--sf-text-secondary);line-height:1.6}
.ops-list li::before{content:'▸';position:absolute;left:1.1rem;color:var(--sf-sol-b)}

/* WHO WE SERVE */
.pills{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:3rem}
.pill{font-family:var(--sf-font-display);font-weight:600;font-size:.82rem;letter-spacing:.25em;text-transform:uppercase;padding:.5rem 1.25rem;border:1px solid var(--sf-ent);color:var(--sf-ent)}
</style>
