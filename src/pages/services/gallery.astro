---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGallery } from '../../lib/gallery';

const photos = await getGallery('services');
---
<BaseLayout
  title="Our Work — Commercial Service & Repair — Streich Force"
  description="Photos of fabrication, compactor chutes, structural repair, gates, fit-outs and maintenance work by Streich Force.">
  <Nav active="services" />

  <section class="gal-hero">
    <div class="gal-hero-inner">
      <p class="sf-eyebrow ent-eye">Division 01 — Commercial Service &amp; Repair</p>
      <h1 class="gal-title">Our <span class="ent-accent">Work</span></h1>
      <p class="gal-sub">What we've built, fixed and fabricated, by service line.</p>
    </div>
    <div class="hero-accent-bar"></div>
  </section>

  <section class="content-section">
    <div class="section-inner">
      <GalleryGrid items={photos} filter eager={3} />
    </div>
  </section>

  <section class="div-cta">
    <div class="cta-inner">
      <h2 class="cta-title">Have a Job Like This?</h2>
      <a href="/contact/enterprise" class="btn-primary">Request Expert Service</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
.gal-hero{position:relative;padding:8rem var(--sf-pad) 3.5rem;background:var(--sf-black)}
.gal-hero-inner{max-width:1200px;margin:0 auto}
.ent-eye{color:var(--sf-ent-b)}
.gal-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(2.6rem,6vw,4.5rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1;margin:1rem 0 1rem}
.ent-accent{color:var(--sf-ent)}
.gal-sub{font-size:1.05rem;color:var(--sf-text-secondary);max-width:640px;line-height:1.8}
.hero-accent-bar{position:absolute;bottom:0;left:0;right:0;height:4px;background:var(--sf-ent)}
.content-section{padding:3.5rem var(--sf-pad) 5rem;background:var(--sf-black)}
.section-inner{max-width:1200px;margin:0 auto}
.div-cta{padding:5rem var(--sf-pad);background:var(--sf-surface);text-align:center}
.cta-inner{max-width:680px;margin:0 auto}
.cta-title{font-family:var(--sf-font-display);font-weight:900;font-size:clamp(1.8rem,4vw,2.6rem);text-transform:uppercase;color:var(--sf-text-primary);line-height:1.1;margin-bottom:1.75rem}
.btn-primary{display:inline-block;font-family:var(--sf-font-display);font-weight:700;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;padding:.9rem 2rem;text-decoration:none;background:var(--sf-ent);color:#fff;transition:background .2s}
.btn-primary:hover{background:var(--sf-ent-b)}
</style>
