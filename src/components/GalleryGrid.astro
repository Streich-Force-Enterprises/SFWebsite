---
// src/components/GalleryGrid.astro
// The one gallery component. /services/gallery renders it with the filter;
// the "See our work" strip on /services renders it with featured photos only.
//
// No JavaScript: the service-line filter is the URL hash + CSS :target, so
// /services/gallery#doors opens filtered (a deep link, and the "See the work"
// links on /services use it). The lightbox is the native Popover API (Esc and
// click-outside close it). A job with three or more photos (#44) shows them in
// a grid on landscape screens and as a scroll-snap swipe strip on phones.
import { Image } from 'astro:assets';
import { SERVICE_LINES, SERVICE_LINE_LABELS, photosOf, type GalleryEntry } from '../lib/gallery';

export interface Props {
  items: GalleryEntry[];
  /** Show the service-line filter above the grid. */
  filter?: boolean;
  /** Unique per page if a page ever renders two grids. */
  name?: string;
  /** Load the first N thumbnails eagerly (set when the grid is above the fold). */
  eager?: number;
}
const { items, filter = false, name = 'gallery', eager = 0 } = Astro.props;

// Only offer filters for service lines that have at least one photo.
const lines = SERVICE_LINES.filter((l) => items.some((i) => i.data.serviceLine === l));
const showFilter = filter && lines.length > 1;

// The filter's anchors use the bare service line as their id (#doors), so a
// page renders at most one filtered grid. Each pill is a link to its anchor;
// the :target anchor hides the other photos and lights its own pill. No
// target (or a hash for a line with no photos) shows everything.
const filterCss = showFilter
  ? lines
      .map(
        (l) =>
          `.gg-${name} #${l}:target~.gg-grid .gg-item:not([data-line="${l}"]){display:none}` +
          `.gg-${name} #${l}:target~.gg-pills a[data-line="${l}"]{background:var(--sf-ent);border-color:var(--sf-ent);color:#fff}`,
      )
      .join('')
  : '';
---
<div class={`gg gg-${name}`}>
  {showFilter && (
    <>
      <style is:inline set:html={filterCss}></style>
      {lines.map((l) => <span class="gg-anchor" id={l}></span>)}
      <nav class="gg-pills" aria-label="Filter by service line">
        <a href="#all" data-line="all">All</a>
        {lines.map((l) => (
          <a href={`#${l}`} data-line={l}>{SERVICE_LINE_LABELS[l]}</a>
        ))}
      </nav>
    </>
  )}

  <ul class="gg-grid">
    {items.map((item, i) => {
      const { caption, alt, serviceLine } = item.data;
      const { cover, hasBefore, all } = photosOf(item);
      const n = all.length;
      const pid = `${name}-lb-${item.id}`;
      // Badge: "Before / After", plus the photo count once a set has more than a pair.
      const badge = [hasBefore && 'Before / After', n > 2 && `${n} photos`].filter(Boolean).join(' · ');
      return (
        <li class="gg-item" data-line={serviceLine}>
          <figure class="gg-card">
            <button class="gg-thumb" type="button" popovertarget={pid} aria-label={`${badge || 'Enlarge'}: ${caption}`}>
              {badge && <span class="gg-badge">{badge}</span>}
              <Image
                src={cover}
                alt={alt ?? caption}
                width={800}
                widths={[400, 800]}
                sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 400px"
                format="webp"
                quality={70}
                loading={i < eager ? 'eager' : 'lazy'}
                fetchpriority={i === 0 && eager > 0 ? 'high' : undefined}
              />
            </button>
            <figcaption class="gg-cap">
              {serviceLine && <span class="gg-line">{SERVICE_LINE_LABELS[serviceLine]}</span>}
              {caption}
            </figcaption>
          </figure>

          <div class="gg-lb" id={pid} popover>
            <figure>
              {n > 1 ? (
                <>
                  {/* A pair sits side by side (stacked on portrait). Three or more: a grid on
                      landscape, a swipe strip on portrait. Scroll snap only, no script. */}
                  <div class:list={['gg-set', { 'gg-many': n > 2, 'gg-rows': n > 3 }]} style={`--cols:${n === 3 ? 3 : 2}`}
                    tabindex={n > 2 ? 0 : undefined} role={n > 2 ? 'group' : undefined}
                    aria-label={n > 2 ? `${n} photos, scroll sideways` : undefined}>
                    {all.map((p, k) => (
                      <div class="gg-stage">
                        <Image src={p.src} alt={`${p.stage}${n > 2 ? ` (${k + 1} of ${n})` : ''}: ${alt ?? caption}`}
                          width={1400} widths={[800, 1400]}
                          sizes="(max-aspect-ratio: 1/1) 92vw, 46vw" format="webp" quality={75} loading="lazy" />
                        <span class={p.stage === 'After' ? 'gg-stage-label gg-after' : 'gg-stage-label'}>
                          {p.stage}{n > 2 && <span class="gg-count"> · {k + 1} / {n}</span>}
                        </span>
                      </div>
                    ))}
                  </div>
                  {n > 2 && <p class="gg-hint" aria-hidden="true">Swipe for all {n} photos →</p>}
                </>
              ) : (
                <Image
                  src={cover}
                  alt={alt ?? caption}
                  width={2000}
                  widths={[1200, 2000]}
                  sizes="92vw"
                  format="webp"
                  quality={75}
                  loading="lazy"
                />
              )}
              <figcaption class="gg-lb-cap">{caption}</figcaption>
            </figure>
            <button class="gg-close" type="button" popovertarget={pid} popovertargetaction="hide" aria-label="Close">×</button>
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  /* Filter targets: empty, just above the pills, clear of the fixed nav. */
  .gg-anchor { display: block; scroll-margin-top: 7rem; }

  .gg-pills { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
  .gg-pills a {
    font-family: var(--sf-font-display); font-weight: 600; font-size: .78rem;
    letter-spacing: .14em; text-transform: uppercase;
    padding: .45rem 1rem; border: 1px solid var(--sf-border-md);
    color: var(--sf-text-secondary); text-decoration: none; transition: border-color .2s, color .2s;
  }
  .gg-pills a:hover { border-color: var(--sf-ent); color: var(--sf-text-primary); }
  .gg-pills a:focus-visible { outline: 2px solid var(--sf-ent-b); outline-offset: 2px; }
  /* "All" is lit until a service line is the target. */
  .gg-pills a[data-line="all"] { background: var(--sf-ent); border-color: var(--sf-ent); color: #fff; }
  .gg-anchor:target ~ .gg-pills a[data-line="all"] { background: none; border-color: var(--sf-border-md); color: var(--sf-text-secondary); }

  .gg-grid {
    list-style: none; display: grid; gap: 2px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .gg-card { position: relative; margin: 0; background: var(--sf-surface); height: 100%; }

  .gg-thumb { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .gg-thumb :global(img) { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; }
  .gg-badge {
    position: absolute; top: .75rem; left: .75rem; z-index: 1;
    font-family: var(--sf-font-display); font-weight: 700; font-size: .7rem;
    letter-spacing: .16em; text-transform: uppercase;
    padding: .3rem .65rem; background: rgba(17,17,17,.85); color: var(--sf-text-primary);
    border-left: 3px solid var(--sf-ent);
  }
  .gg-thumb:focus-visible { outline: 2px solid var(--sf-ent-b); outline-offset: -2px; }

  /* Phones and touch: caption sits below the photo. */
  .gg-cap {
    padding: .85rem 1rem 1.1rem; font-size: .95rem; line-height: 1.5;
    color: var(--sf-text-secondary);
  }
  .gg-line {
    display: block; margin-bottom: .2rem;
    font-family: var(--sf-font-display); font-weight: 600; font-size: .72rem;
    letter-spacing: .2em; text-transform: uppercase; color: var(--sf-ent-b);
  }

  /* Mouse: caption slides up over the photo on hover or keyboard focus. */
  @media (hover: hover) and (pointer: fine) {
    .gg-cap {
      position: absolute; left: 0; right: 0; bottom: 0; pointer-events: none;
      background: linear-gradient(to top, rgba(17,17,17,.95) 30%, rgba(17,17,17,0));
      color: var(--sf-text-primary); padding-top: 2.5rem;
      opacity: 0; transform: translateY(8px); transition: opacity .2s, transform .2s;
    }
    .gg-card:hover .gg-cap,
    .gg-card:focus-within .gg-cap { opacity: 1; transform: none; }
  }

  /* Lightbox (native popover, top layer). */
  .gg-lb {
    margin: auto; padding: 0; border: 0; background: transparent;
    max-width: 92vw; max-height: 92vh; overflow: visible; color: var(--sf-text-primary);
  }
  .gg-lb::backdrop { background: rgba(0,0,0,.88); }
  .gg-lb figure { margin: 0; }
  .gg-lb :global(img) { width: auto; height: auto; max-width: 92vw; max-height: calc(92vh - 4rem); object-fit: contain; margin: 0 auto; }
  /* A set: a pair side by side on landscape screens, stacked on portrait.
     Three photos sit in a row, four or more in two columns. */
  .gg-set { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 4px; }
  .gg-stage { position: relative; }
  .gg-set .gg-stage :global(img) { max-width: calc(92vw / var(--cols)); max-height: calc(92vh - 4rem); }
  .gg-rows .gg-stage :global(img) { max-height: calc((92vh - 5rem) / 2); }
  .gg-many:focus-visible { outline: 2px solid var(--sf-ent-b); outline-offset: 2px; }
  .gg-hint { display: none; }
  .gg-stage-label {
    position: absolute; top: .75rem; left: .75rem;
    font-family: var(--sf-font-display); font-weight: 700; font-size: .78rem;
    letter-spacing: .2em; text-transform: uppercase;
    padding: .3rem .7rem; background: rgba(17,17,17,.85); color: var(--sf-text-secondary);
  }
  .gg-stage-label.gg-after { color: #fff; background: var(--sf-ent); }
  @media (max-aspect-ratio: 1/1) {
    .gg-set { grid-template-columns: 1fr; }
    .gg-set .gg-stage :global(img) { max-width: 92vw; max-height: calc((92vh - 5rem) / 2); }
    /* Three or more on a phone: one photo at a time, swipe to the next. */
    .gg-many {
      display: flex; max-width: 92vw; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .gg-many .gg-stage { flex: 0 0 100%; scroll-snap-align: center; display: flex; justify-content: center; }
    .gg-many .gg-stage :global(img) { max-width: 92vw; max-height: calc(92vh - 6rem); }
    .gg-hint { display: block; margin: .5rem 0 0; text-align: center; font-size: .85rem; color: var(--sf-text-secondary); }
  }
  .gg-lb-cap { padding: .75rem 0 0; text-align: center; font-size: 1rem; color: var(--sf-text-secondary); }
  .gg-close {
    position: absolute; top: .5rem; right: .5rem;
    width: 2.5rem; height: 2.5rem; border: 1px solid var(--sf-border-md); background: var(--sf-black);
    color: var(--sf-text-primary); font-size: 1.6rem; line-height: 1; cursor: pointer;
  }
  .gg-close:hover, .gg-close:focus-visible { border-color: var(--sf-ent); color: var(--sf-ent-b); }

  @media (prefers-reduced-motion: reduce) {
    .gg-cap, .gg-pills a { transition: none; }
  }
</style>
